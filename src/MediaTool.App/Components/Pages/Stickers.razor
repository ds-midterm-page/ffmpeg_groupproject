@page "/stickers"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MediaTool.Media
@inject StickerConverter Converter
@inject ILogger<Stickers> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Telegram stickers · MediaTool</PageTitle>
<main class="page">
    <h1>Telegram stickers</h1>
    <p class="hint">Upload an image or video and save a Telegram-ready sticker.</p>
    <section class="quality">
        <h3>Mode</h3>
        <label class="option"><input type="radio" name="mode" checked="@(_mode == "static")" disabled="@_busy" @onchange='() => SetMode("static")' /> Static image <span>PNG / WEBP · transparency preserved</span></label>
        <label class="option"><input type="radio" name="mode" checked="@(_mode == "video")" disabled="@_busy" @onchange='() => SetMode("video")' /> Video <span>WEBM · VP9 · no sound · up to 256 KB</span></label>
    </section>
    <div class="paste">
        <InputFile @ref="_upload" OnChange="SelectFile" accept="image/*,video/*,.webm,.gif" disabled="@_busy" />
    </div>
    @if (_file is not null)
    {
        <p class="meta">@_file.Name · @((_file.Size / 1024.0).ToString("0.0")) KB</p>
    }
    @if (_preview is not null)
    {
        <section class="preview">
            @if (_file?.ContentType.StartsWith("video/", StringComparison.Ordinal) == true)
            {
                <video @ref="_video" src="@_preview" controls preload="metadata"></video>
                @if (_mode == "video" && _option is "frame" or "segment")
                {
                    <button type="button" class="primary" @onclick="UseCurrentTime" disabled="@_busy">Use current frame time</button>
                }
            }
            else { <img src="@_preview" alt="Uploaded media preview" /> }
        </section>
    }
    @if (_mode == "static")
    {
        <section class="quality">
            <h3>Output format</h3>
            <select @bind="_format" disabled="@_busy" aria-label="Static output format"><option value="webp">WEBP</option><option value="png">PNG</option></select>
        </section>
    }
    else
    {
        <section class="quality">
            <h3>Video option</h3>
            <select @bind="_option" disabled="@_busy" aria-label="Video option">
                <option value="speed">Speed up to fit 3 seconds</option>
                <option value="first">Take the first 3 seconds</option>
                <option value="segment">Select a segment</option>
                <option value="frame">Choose a frame and hold it as a loop</option>
            </select>
            @if (_option is "segment" or "frame")
            {
                <p><label>@(_option == "frame" ? "Frame time (seconds)" : "Start (seconds)") <input type="number" min="0" step="0.01" @bind="_start" disabled="@_busy" /></label></p>
            }
            @if (_option == "segment")
            {
                <p><label>Length (up to 3 seconds) <input type="number" min="0.04" max="3" step="0.01" @bind="_length" disabled="@_busy" /></label></p>
            }
            <p><label class="sound"><input type="checkbox" @bind="_crop" disabled="@_busy" /> Crop detected black edges</label></p>
            <p class="hint">No borders are added. Moving clips play forward and backward for a smooth loop. Frame mode holds one frame.</p>
        </section>
    }
    <section class="download">
        <button type="button" class="primary" disabled="@(_busy || _file is null)" @onclick="ConvertAsync">@(_busy ? "Converting…" : "Create sticker")</button>
        @if (_busy) { <p class="status" role="status">Converting and checking your sticker…</p> }
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
        @if (_result is { } result)
        {
            <p class="status done">Ready · @result.Size bytes (@((result.Size / 1024.0).ToString("0.0")) KB)</p>
            @if (result.Extension == "webm")
            {
                <p class="hint">WEBM · VP9 · ≤3 seconds · ≤30 FPS · no audio</p>
            }
            <a class="save" href="stickers/files/@result.Id" download="@("sticker." + result.Extension)">Save sticker</a>
            <p class="hint">The file is available for one download, for up to one hour.</p>
        }
    </section>
</main>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private IBrowserFile? _file;
    private string _mode = "static", _format = "webp", _option = "speed";
    private double _start, _length = 3;
    private bool _crop = true, _busy;
    private string? _error;
    private StickerResult? _result;
    private InputFile? _upload;
    private IJSObjectReference? _module;
    private string? _preview;
    private ElementReference _video;

    private async Task SelectFile(InputFileChangeEventArgs args)
    {
        _file = args.File; _error = null; _result = null; _start = 0; _preview = null;
        StateHasChanged();
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./sticker-preview.js");
        _preview = await _module.InvokeAsync<string>("preview", _upload!.Element);
    }
    private async Task UseCurrentTime()
    {
        if (_module is not null) _start = await _module.InvokeAsync<double>("currentTime", _video);
    }
    private void SetMode(string mode) { _mode = mode; _error = null; _result = null; }
    private async Task ConvertAsync()
    {
        if (_file is null || _busy) return;
        _busy = true; _error = null; _result = null;
        try
        {
            await using var input = _file.OpenReadStream(50 * 1024 * 1024, _disposed.Token);
            _result = await Converter.ConvertAsync(input, _mode, _mode == "video" ? "webm" : _format,
                _option, _start, _option == "segment" ? _length : 3, _crop, _disposed.Token);
        }
        catch (OperationCanceledException) { _error = "Conversion cancelled or timed out."; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Sticker conversion failed");
            _error = ex is InvalidOperationException or ArgumentException ? ex.Message : "Cannot convert this file. Check the file, Python and FFmpeg installation. Upload limit: 50 MB.";
        }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed.Cancel(); _disposed.Dispose();
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("release"); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
