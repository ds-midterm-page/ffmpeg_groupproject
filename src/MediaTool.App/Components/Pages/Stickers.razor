@page "/stickers"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MediaTool.Media
@inject StickerConverter Converter
@inject ILogger<Stickers> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Telegram stickers · MediaTool</PageTitle>
<main class="page">
    <h1>Telegram stickers</h1>
    <p class="hint">Upload an image or video and save a Telegram-ready sticker.</p>
    <section class="quality">
        <h3>Mode</h3>
        <div class="choices" role="radiogroup" aria-label="Sticker mode">
            <label class="choice @(_mode == "static" ? "selected" : null)"><input type="radio" name="mode" checked="@(_mode == "static")" disabled="@_busy" @onchange='() => SetMode("static")' /> IMG</label>
            <label class="choice @(_mode == "video" ? "selected" : null)"><input type="radio" name="mode" checked="@(_mode == "video")" disabled="@_busy" @onchange='() => SetMode("video")' /> WEBM</label>
        </div>
    </section>
    <div class="upload-area @(_busy ? "disabled" : null)">
        <InputFile @ref="_upload" OnChange="SelectFile" accept="image/*,video/*,.webm,.gif" aria-label="Choose or drop media" disabled="@_busy" />
        <span>Choose a file or drag and drop it here</span>
    </div>
    @if (_file is not null)
    {
        <p class="meta">@_file.Name · @((_file.Size / 1024.0).ToString("0.0")) KB</p>
    }
    @if (_preview is not null)
    {
        <section class="preview source-preview">
            @if (_sourceIsVideo)
            {
                <video @ref="_video" src="@_preview" controls preload="metadata"></video>
                @if (_mode == "static" || _option == "segment")
                {
                    <button type="button" class="primary" @onclick="UseCurrentTime" disabled="@_busy">Use current frame time</button>
                }
            }
            else { <img src="@_preview" alt="Uploaded media preview" /> }
        </section>
    }
    @if (_mode == "static")
    {
        <section class="quality">
            <h3>Output format</h3>
            <div class="choices" role="radiogroup" aria-label="Image format">
                @foreach (var format in new[] { "webp", "png" })
                {
                    <label class="choice @(_format == format ? "selected" : null)"><input type="radio" name="format" checked="@(_format == format)" disabled="@_busy" @onchange="() => SetFormat(format)" /> @format.ToUpperInvariant()</label>
                }
            </div>
            @if (_sourceIsVideo)
            {
                <p><label>Frame time (seconds) <input type="number" min="0" step="0.01" @bind="_start" @bind:after="Invalidate" disabled="@_busy" /></label></p>
            }
        </section>
    }
    else
    {
        <section class="quality">
            <h3>Video option</h3>
            <div class="choices" role="radiogroup" aria-label="Video option">
                @foreach (var item in VideoChoices)
                {
                    <label class="choice @(_option == item.Key ? "selected" : null)"><input type="radio" name="video-option" checked="@(_option == item.Key)" disabled="@_busy" @onchange="() => SetOption(item.Key)" /> @item.Label</label>
                }
            </div>
            @if (_option == "segment")
            {
                <p><label>Start (seconds) <input type="number" min="0" step="0.01" @bind="_start" @bind:after="Invalidate" disabled="@_busy" /></label></p>
                <p><label>Length (up to 3 seconds) <input type="number" min="0.04" max="3" step="0.01" @bind="_length" @bind:after="Invalidate" disabled="@_busy" /></label></p>
            }
            <p><label class="sound"><input type="checkbox" @bind="_crop" @bind:after="Invalidate" disabled="@_busy" /> Crop detected black edges</label></p>
        </section>
    }
    <section class="download">
        @if (_result is { } result)
        {
            <h3>Sticker preview</h3>
            <div class="sticker-preview">
                @if (result.Extension == "webm")
                {
                    <video @key="result.Id" src="@ResultUrl(result)" autoplay loop muted playsinline controls></video>
                }
                else { <img src="@ResultUrl(result)" alt="Created sticker preview" /> }
            </div>
            <p class="status done">@(result.Extension == "webm" ? "WEBM" : "IMG") · @((result.Size / 1024.0).ToString("0.0")) KB</p>
            <a class="save" href="@(ResultUrl(result) + "?download=true")" download="@("sticker." + result.Extension)">Save sticker</a>
        }
        else
        {
            <button type="button" class="primary" disabled="@(_busy || _source is null)" @onclick="ConvertAsync">@(_uploading ? "Uploading…" : _busy ? "Converting…" : "Create sticker")</button>
        }
        @if (_busy && !_uploading) { <p class="status" role="status">Converting and checking your sticker…</p> }
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
    </section>
</main>

@code {
    private static readonly (string Key, string Label)[] VideoChoices = [
        ("speed", "Speed up to fit 3 seconds"), ("first", "Take the first 3 seconds"),
        ("segment", "Select a segment"), ("loop", "Find a seamless loop")];
    private readonly CancellationTokenSource _disposed = new();
    private IBrowserFile? _file;
    private byte[]? _source;
    private string _mode = "static", _format = "webp", _option = "speed";
    private double _start, _length = 3;
    private bool _crop = true, _busy, _uploading, _sourceIsVideo;
    private string? _error, _preview;
    private StickerResult? _result;
    private InputFile? _upload;
    private IJSObjectReference? _module;
    private ElementReference _video;

    private static string ResultUrl(StickerResult result) => $"stickers/files/{result.Id}";
    private void Invalidate() { _result = null; _error = null; }
    private void SetMode(string value) { _mode = value; Invalidate(); }
    private void SetFormat(string value) { _format = value; Invalidate(); }
    private void SetOption(string value) { _option = value; Invalidate(); }

    private async Task SelectFile(InputFileChangeEventArgs args)
    {
        _busy = true; _uploading = true;
        _file = args.File; _source = null; _start = 0; _preview = null; Invalidate();
        _sourceIsVideo = _file.ContentType.StartsWith("video/", StringComparison.Ordinal)
            || new[] { ".mp4", ".webm", ".mov", ".mkv" }.Contains(Path.GetExtension(_file.Name).ToLowerInvariant());
        try
        {
            // Read once; settings changes and downloads never reopen the browser file.
            await using var input = _file.OpenReadStream(50 * 1024 * 1024, _disposed.Token);
            using var cache = new MemoryStream();
            await input.CopyToAsync(cache, _disposed.Token);
            _source = cache.ToArray();
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./sticker-preview.js");
            _preview = await _module.InvokeAsync<string>("preview", _upload!.Element);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Sticker upload failed");
            _source = null;
            _error = "Could not read this file. Choose it again or drag and drop it here. Upload limit: 50 MB.";
        }
        finally { _busy = false; _uploading = false; }
    }
    private async Task UseCurrentTime()
    {
        if (_module is not null) _start = await _module.InvokeAsync<double>("currentTime", _video);
        Invalidate();
    }
    private async Task ConvertAsync()
    {
        if (_source is null || _busy) return;
        _busy = true; Invalidate();
        try
        {
            using var input = new MemoryStream(_source, writable: false);
            _result = await Converter.ConvertAsync(input, _mode, _mode == "video" ? "webm" : _format,
                _option, _start, _option == "segment" ? _length : 3, _crop, _disposed.Token);
        }
        catch (OperationCanceledException) { _error = "Conversion cancelled or timed out."; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Sticker conversion failed");
            _error = ex is InvalidOperationException or ArgumentException ? ex.Message : "Cannot convert this file. Check the file, Python and FFmpeg installation.";
        }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed.Cancel(); _disposed.Dispose(); _source = null;
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("release"); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
