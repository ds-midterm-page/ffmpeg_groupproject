@page "/"
@* No prerender: otherwise a link pasted before the live connection starts is silently wiped. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using MediaTool.Core.Download
@using MediaTool.Core.Formats
@using MediaTool.Core.Metadata
@using MediaTool.Media
@using Microsoft.Extensions.Localization
@inject MetadataService Metadata
@inject IStringLocalizer<SharedResource> L
@inject JobQueue Jobs
@implements IDisposable

<PageTitle>MediaTool</PageTitle>

<main class="page">
    <h1>MediaTool</h1>
    <p class="hint">@L["Home.Hint"]</p>

    <form class="paste" @onsubmit="LoadPreviewAsync">
        <input type="text" @bind="_link" @bind:event="oninput" placeholder="https://www.youtube.com/watch?v=…"
               aria-label="@L["Home.LinkLabel"]" autocomplete="off" spellcheck="false" disabled="@_loading" />
        <button type="submit" disabled="@(_loading || string.IsNullOrWhiteSpace(_link))">
            @(_loading ? L["Home.Loading"] : L["Home.Preview"])
        </button>
    </form>

    @if (_result is { IsSuccess: false } failed)
    {
        <p class="error" role="alert">@L[$"Error.{failed.Error}"]</p>
    }
    else if (_result?.Metadata is { } video)
    {
        <section class="preview">
            @if (video.ThumbnailUrl is not null)
            {
                <img src="@video.ThumbnailUrl" alt="" referrerpolicy="no-referrer" />
            }
            <div class="details">
                <h2>@video.Title</h2>
                @if (video.Uploader is not null)
                {
                    <p class="uploader">@video.Uploader</p>
                }
                <p class="meta">
                    <span>@L["Home.Length", DurationFormatter.Format(video.Duration)]</span>
                </p>
            </div>
        </section>

        <section class="quality">
            <div class="quality-head">
                <h3>@L["Home.Quality"]</h3>
                <label class="sound">
                    <input type="checkbox" checked="@_includeSound" disabled="@(_job is { IsFinished: false })"
                           @onchange="e => SetIncludeSound(video, e.Value is true)" />
                    @L["Home.IncludeSound"]
                </label>
            </div>
            @if (_options.Count == 0)
            {
                <p class="error" role="alert">@L["Home.NoQuality"]</p>
            }
            else
            {
                <div role="radiogroup" aria-label="@L["Home.Quality"]">
                    @foreach (var option in _options)
                    {
                        <label class="option @(option.ExceedsLimit ? "too-large" : null) @(option == _selected ? "selected" : null)">
                            <input type="radio" name="quality" checked="@(option == _selected)" disabled="@option.ExceedsLimit"
                                   @onchange="() => _selected = option" />
                            <span class="name">@(option.Mp3BitrateKbps is { } kbps ? L["Home.Kbps", kbps].Value : option.Label)</span>
                            <span class="type">@option.Extension.ToUpperInvariant()@(option.Kind == QualityKind.Video && !option.HasAudio ? $" · {L["Home.NoSound"]}" : null)</span>
                            <span class="size">
                                @(option.IsSizeEstimated && option.EstimatedBytes is not null ? L["Home.About", Size(option.EstimatedBytes)].Value : Size(option.EstimatedBytes))
                                @if (option.ExceedsLimit)
                                {
                                    <em> · @L["Home.OverLimit"]</em>
                                }
                            </span>
                        </label>
                    }
                </div>
                @if (_selected is null)
                {
                    <p class="error" role="alert">@L["Error.TooLarge"]</p>
                }
            }
        </section>

        @if (_selected is not null)
        {
            <section class="download">
                @if (_job is null || _job.IsFinished)
                {
                    <button type="button" class="primary" @onclick="() => StartDownloadAsync(video)">
                        @DownloadLabel(_selected)
                    </button>
                }

                @if (_job is { } job)
                {
                    @switch (job.Status)
                    {
                        case JobStatus.Queued:
                            <p class="status">@L["Status.Queued"]</p>
                            break;
                        case JobStatus.Downloading:
                            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(job.Percent ?? 0))">
                                <div class="bar" style="width: @(((int)(job.Percent ?? 0)).ToString(CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <p class="status">@L["Status.Downloading"] @(job.Percent is { } p ? $"{(int)p}%" : null)</p>
                            break;
                        case JobStatus.Completed when job.FilePath is not null:
                            <p class="status done">@L["Status.Ready", Size(job.FileSizeBytes)]</p>
                            <a class="save" href="files/@job.Id" download="@job.DownloadName">@L["Status.Save", job.DownloadName ?? string.Empty]</a>
                            break;
                        case JobStatus.Completed:
                            <p class="status done">@L["Status.Saved"]</p>
                            break;
                        case JobStatus.Cancelled:
                            <p class="error" role="alert">@L["Status.Cancelled"]</p>
                            break;
                        default:
                            <p class="error" role="alert">@L[$"Error.{job.Error}"]</p>
                            break;
                    }
                }
            </section>
        }
    }
</main>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private string? _link;
    private bool _loading;
    private MetadataResult? _result;
    private IReadOnlyList<QualityOption> _options = [];
    private QualityOption? _selected;
    private JobSnapshot? _job;
    private bool _includeSound = true;

    /// <summary>Sizes in the current language, e.g. "3,3 МБ".</summary>
    private string Size(long? bytes) => SizeFormatter.Format(
        bytes, new SizeUnits(L["Size.KB"], L["Size.MB"], L["Size.GB"], L["Size.Unknown"]), CultureInfo.CurrentCulture);

    private string DownloadLabel(QualityOption option) => option switch
    {
        { Mp3BitrateKbps: { } kbps } => L["Home.Download", L["Home.Mp3", kbps].Value],
        { Kind: QualityKind.Video, HasAudio: false } => L["Home.DownloadNoSound", option.Label],
        _ => L["Home.Download", option.Label],
    };

    private void SetIncludeSound(VideoMetadata video, bool include)
    {
        _includeSound = include;
        var previousLabel = _selected?.Label;
        _options = FormatPicker.GetOptions(video, _includeSound);
        _selected = _options.FirstOrDefault(o => o.Label == previousLabel && !o.ExceedsLimit)
            ?? _options.FirstOrDefault(o => !o.ExceedsLimit);
    }

    protected override void OnInitialized() => Jobs.Store.Changed += OnJobChanged;

    private async Task StartDownloadAsync(VideoMetadata video)
    {
        if (_selected is null || _job is { IsFinished: false })
        {
            return;
        }

        var url = video.WebpageUrl ?? new Uri(_link!.Contains("://", StringComparison.Ordinal) ? _link.Trim() : "https://" + _link.Trim());
        var id = await Jobs.EnqueueAsync(new DownloadRequest(url, video.Title, _selected), _disposed.Token);
        _job = Jobs.Store.Get(id);
    }

    private void OnJobChanged(JobSnapshot snapshot)
    {
        if (_job?.Id != snapshot.Id)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            _job = snapshot;
            StateHasChanged();
        });
    }

    private async Task LoadPreviewAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _result = null;
        try
        {
            _options = [];
            _selected = null;
            _job = null;
            _result = await Metadata.GetMetadataAsync(_link, _disposed.Token);
            if (_result.Metadata is { } metadata)
            {
                _options = FormatPicker.GetOptions(metadata, _includeSound);
                _selected = _options.FirstOrDefault(o => !o.ExceedsLimit);
            }
        }
        catch (OperationCanceledException)
        {
            // page closed while loading
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        Jobs.Store.Changed -= OnJobChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
