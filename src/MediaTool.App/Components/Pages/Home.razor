@page "/"
@* No prerender: otherwise a link pasted before the live connection starts is silently wiped. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using MediaTool.Core.Download
@using MediaTool.Core.Formats
@using MediaTool.Core.Metadata
@using MediaTool.Media
@inject MetadataService Metadata
@inject JobQueue Jobs
@implements IDisposable

<PageTitle>MediaTool</PageTitle>

<main class="page">
    <h1>MediaTool</h1>
    <p class="hint">Paste a link from YouTube, TikTok, Instagram or X.</p>

    <form class="paste" @onsubmit="LoadPreviewAsync">
        <input type="text" @bind="_link" @bind:event="oninput" placeholder="https://www.youtube.com/watch?v=…"
               aria-label="Video link" autocomplete="off" spellcheck="false" disabled="@_loading" />
        <button type="submit" disabled="@(_loading || string.IsNullOrWhiteSpace(_link))">
            @(_loading ? "Loading…" : "Preview")
        </button>
    </form>

    @if (_result is { IsSuccess: false } failed)
    {
        <p class="error" role="alert">@failed.Message</p>
    }
    else if (_result?.Metadata is { } video)
    {
        <section class="preview">
            @if (video.ThumbnailUrl is not null)
            {
                <img src="@video.ThumbnailUrl" alt="" referrerpolicy="no-referrer" />
            }
            <div class="details">
                <h2>@video.Title</h2>
                @if (video.Uploader is not null)
                {
                    <p class="uploader">@video.Uploader</p>
                }
                <p class="meta">
                    <span>Length: @DurationFormatter.Format(video.Duration)</span>
                </p>
            </div>
        </section>

        <section class="quality">
            <h3>Quality</h3>
            @if (_options.Count == 0)
            {
                <p class="error" role="alert">No downloadable quality was found for this video.</p>
            }
            else
            {
                <div role="radiogroup" aria-label="Quality">
                    @foreach (var option in _options)
                    {
                        <label class="option @(option.ExceedsLimit ? "too-large" : null) @(option == _selected ? "selected" : null)">
                            <input type="radio" name="quality" checked="@(option == _selected)" disabled="@option.ExceedsLimit"
                                   @onchange="() => _selected = option" />
                            <span class="name">@option.Label</span>
                            <span class="type">@option.Extension.ToUpperInvariant()@(option.Kind == QualityKind.Video && !option.HasAudio ? " · no sound" : null)</span>
                            <span class="size">
                                @(option.IsSizeEstimated && option.EstimatedBytes is not null ? "about " : null)@SizeFormatter.Format(option.EstimatedBytes)
                                @if (option.ExceedsLimit)
                                {
                                    <em> · over 50 MB</em>
                                }
                            </span>
                        </label>
                    }
                </div>
                @if (_selected is null)
                {
                    <p class="error" role="alert">@MediaErrorMessages.For(MediaError.TooLarge)</p>
                }
            }
        </section>

        @if (_selected is not null)
        {
            <section class="download">
                @if (_job is null || _job.IsFinished)
                {
                    <button type="button" class="primary" @onclick="() => StartDownloadAsync(video)">
                        Download @_selected.Label
                    </button>
                }

                @if (_job is { } job)
                {
                    @switch (job.Status)
                    {
                        case JobStatus.Queued:
                            <p class="status">Waiting to start…</p>
                            break;
                        case JobStatus.Downloading:
                            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(job.Percent ?? 0))">
                                <div class="bar" style="width: @(((int)(job.Percent ?? 0)).ToString(CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <p class="status">Downloading… @(job.Percent is { } p ? $"{(int)p}%" : null)</p>
                            break;
                        case JobStatus.Completed when job.FilePath is not null:
                            <p class="status done">Ready (@SizeFormatter.Format(job.FileSizeBytes)).</p>
                            <a class="save" href="files/@job.Id" download="@job.DownloadName">Save @job.DownloadName</a>
                            break;
                        case JobStatus.Completed:
                            <p class="status done">Saved. Check your Downloads folder.</p>
                            break;
                        default:
                            <p class="error" role="alert">@job.Message</p>
                            break;
                    }
                }
            </section>
        }
    }
</main>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private string? _link;
    private bool _loading;
    private MetadataResult? _result;
    private IReadOnlyList<QualityOption> _options = [];
    private QualityOption? _selected;
    private JobSnapshot? _job;

    protected override void OnInitialized() => Jobs.Store.Changed += OnJobChanged;

    private async Task StartDownloadAsync(VideoMetadata video)
    {
        if (_selected is null || _job is { IsFinished: false })
        {
            return;
        }

        var url = video.WebpageUrl ?? new Uri(_link!.Contains("://", StringComparison.Ordinal) ? _link.Trim() : "https://" + _link.Trim());
        var id = await Jobs.EnqueueAsync(new DownloadRequest(url, video.Title, _selected), _disposed.Token);
        _job = Jobs.Store.Get(id);
    }

    private void OnJobChanged(JobSnapshot snapshot)
    {
        if (_job?.Id != snapshot.Id)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            _job = snapshot;
            StateHasChanged();
        });
    }

    private async Task LoadPreviewAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _result = null;
        try
        {
            _options = [];
            _selected = null;
            _job = null;
            _result = await Metadata.GetMetadataAsync(_link, _disposed.Token);
            if (_result.Metadata is { } metadata)
            {
                _options = FormatPicker.GetOptions(metadata);
                _selected = _options.FirstOrDefault(o => !o.ExceedsLimit);
            }
        }
        catch (OperationCanceledException)
        {
            // page closed while loading
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        Jobs.Store.Changed -= OnJobChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
