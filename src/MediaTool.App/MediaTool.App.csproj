<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MediaTool.Core\MediaTool.Core.csproj" />
    <ProjectReference Include="..\MediaTool.Media\MediaTool.Media.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Tool binaries (yt-dlp.exe, later ffmpeg) are downloaded into tools\ locally and copied next to the app; not committed. -->
  <ItemGroup>
    <None Include="tools\*.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\backend\stickers.py" Link="stickers\stickers.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\backend\sticker_loop.py" Link="stickers\sticker_loop.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
